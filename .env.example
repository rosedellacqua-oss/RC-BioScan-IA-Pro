# ============================================================
# RC-BioScan IA PRO – Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA commite o .env.local com valores reais!
# ============================================================

# ------------------------------------------------------------
# Google Gemini API
# Obtenha em: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=sua_chave_gemini_aqui

# ------------------------------------------------------------
# Supabase – Conexão PostgreSQL direta (para migrations/server-side)
# Obtenha em: https://supabase.com/dashboard/project/<seu-projeto>/settings/database
# ------------------------------------------------------------
POSTGRES_DATABASE="postgres"
POSTGRES_HOST="db.<seu-ref>.supabase.co"
POSTGRES_PASSWORD="sua_senha_postgres"
POSTGRES_PRISMA_URL="postgres://postgres.<seu-ref>:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
POSTGRES_URL="postgres://postgres.<seu-ref>:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x"
POSTGRES_URL_NON_POOLING="postgres://postgres.<seu-ref>:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
POSTGRES_USER="postgres"

# ------------------------------------------------------------
# Supabase – Chaves da API
# Obtenha em: https://supabase.com/dashboard/project/<seu-projeto>/settings/api
# ------------------------------------------------------------
SUPABASE_ANON_KEY="sua_anon_key_aqui"
SUPABASE_JWT_SECRET="seu_jwt_secret_aqui"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key_aqui"
SUPABASE_URL="https://<seu-ref>.supabase.co"

# ------------------------------------------------------------
# Variáveis expostas ao browser pelo Vite (prefixo VITE_ obrigatório)
# Copie os mesmos valores de SUPABASE_URL, SUPABASE_ANON_KEY e
# SUPABASE_SERVICE_ROLE_KEY acima.
# ATENÇÃO: VITE_SUPABASE_SERVICE_ROLE_KEY é exposta ao browser –
# use apenas em ambientes controlados ou mova a lógica admin para
# um backend/Edge Function seguro em produção.
# ------------------------------------------------------------
VITE_SUPABASE_URL="https://<seu-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_anon_key_aqui"
VITE_SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key_aqui"
